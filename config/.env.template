# Rendered to config/.env via config/env-render.sh — ${VAR:-default} forms are
# evaluated against the current environment at render time.
# Secrets stay blank here (env_template_rules): never commit non-empty literals.
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN:-}
TG_BOT_API_URL=${TG_BOT_API_URL:-http://localhost:8340}
TG_BOT_HOST=${TG_BOT_HOST:-0.0.0.0}
TG_BOT_PORT=${TG_BOT_PORT:-8340}
TG_BOT_LOG_LEVEL=${TG_BOT_LOG_LEVEL:-INFO}
# Service chat mirroring bot activity; from a t.me/c/<internal>/<thread> link.
TG_BOT_SERVICE_CHAT_ID=${TG_BOT_SERVICE_CHAT_ID:-}
TG_BOT_SERVICE_THREAD_ID=${TG_BOT_SERVICE_THREAD_ID:-}
TG_BOT_SERVICE_NOTIFY=${TG_BOT_SERVICE_NOTIFY:-true}
# Confine group traffic to SERVICE_THREAD_ID alone; private chats are unaffected.
# false = serve every topic of the service chat. Reading plain messages in the topic also
# needs privacy mode OFF in BotFather (/setprivacy → Disable) — `make doctor` checks it.
TG_BOT_SERVICE_TOPIC_ONLY=${TG_BOT_SERVICE_TOPIC_ONLY:-true}
# Subtitle providers, priority order — same set as the CLI/skill flow (podnapisi omitted:
# DNS-dead). gestdown=TV episodes, yify+subtitlecat=films.
TG_BOT_SRT_PROVIDERS=${TG_BOT_SRT_PROVIDERS:-gestdown,yify,subtitlecat}
# Reuse the wordsman repo's data/in + data/out as a cache (needs its Git-LFS content
# present on this host); false forces live fetch+generation every time.
TG_BOT_USE_REPO_CACHE=${TG_BOT_USE_REPO_CACHE:-true}
TG_BOT_REPO_DATA_DIR=${TG_BOT_REPO_DATA_DIR:-}
# Standalone checkouts only; auto-detected in the submodule layout.
TG_BOT_WORDSMAN_ROOT=${TG_BOT_WORDSMAN_ROOT:-}
