# syntax=docker/dockerfile:1
# Self-contained cloud image (Fly.io / Render): bakes the parent wordsman checkout
# instead of the docker-compose bind-mount. deploy/Dockerfile stays the local/dev image.
FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Parent checkout: main.py + scripts/fetch_srt.sh + subproducts. srt-search is a
# submodule (public URL); audio-search is a plain directory on this branch. Git-LFS is
# deliberately absent: data/ checks out as pointer files and the repo cache degrades
# to live fetches (see config/config.yml use_repo_cache).
# WORDSMAN_REF must be a branch that still EXISTS: the old feat/productionize-green-ci
# was deleted when everything was consolidated into main (wordsman#31, 2026-08-24), and a
# rebuild against a deleted branch fails at `git clone`, not at runtime. main now carries
# both the srt-search submodule pin and the audio-search directory.
#
# hnkovr/wordsman is PRIVATE, so this clone needs a credential — and the credential must
# never end up in the image. A build ARG would: ARG values persist in image metadata for
# anyone who can pull. So the token arrives as a Render *secret file* named `gh_token`,
# which Render drops into the build context, and is bind-mounted for exactly one RUN.
# A mount leaves nothing in the layer, and `$(cat …)` is not expanded in the build log.
#
# Building this image locally therefore needs that file present in the context:
#     printf '%s' "$WORDSMAN_REPO_READ_TOKEN" > gh_token     # never commit it
# Publishing the repo is NOT an alternative — see wordsman#49.
ARG WORDSMAN_REPO=github.com/hnkovr/wordsman
ARG WORDSMAN_REF=main
RUN --mount=type=bind,source=gh_token,target=/run/gh_token \
    git -c credential.helper='!f(){ echo username=x-access-token; echo "password=$(cat /run/gh_token)"; };f' \
    clone --depth 1 --branch "$WORDSMAN_REF" \
    --recurse-submodules=subproducts/srt-search --shallow-submodules \
    "https://$WORDSMAN_REPO" /wordsman

# Pre-sync the venvs `uv run` uses (fetch_srt.sh and the RU online legs) with the same
# default groups `uv run` syncs, so no request ever pays the resolver/install cost.
RUN cd /wordsman/subproducts/srt-search && uv sync \
    && cd /wordsman/subproducts/audio-search && uv sync

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY config ./config
RUN pip install --no-cache-dir .
COPY deploy/entrypoint.sh /usr/local/bin/tg-bot-cloud
RUN chmod +x /usr/local/bin/tg-bot-cloud

ENV TG_BOT_WORDSMAN_ROOT=/wordsman
EXPOSE 8340
CMD ["tg-bot-cloud"]
